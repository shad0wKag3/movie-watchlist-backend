{
  "name": "movie-watchlist-backend",
  "version": "1.0.0",
  "description": "GDGoC Movie Watchlist & Review Platform Backend Service",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "node prisma/seed.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand --detectOpenHandles --forceExit",
    "test:unit": "cross-env NODE_OPTIONS=--experimental-vm-modules jest tests/unit --runInBand",
    "test:integration": "cross-env NODE_OPTIONS=--experimental-vm-modules jest tests/integration --runInBand",
    "db:clean-users": "node scripts/clean-users.js"
  },
  "keywords": [
    "gdgoc",
    "express",
    "prisma",
    "postgresql",
    "neon",
    "gemini",
    "watchlist",
    "movies"
  ],
  "author": "GDGoC",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0"
  }
}

